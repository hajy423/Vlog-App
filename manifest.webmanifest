{
  "name": "Vlog",
  "short_name": "Vlog",
  "description": "Record 1-4 second timestamped video clips and stitch them into one vlog.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
